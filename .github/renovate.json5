{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // This repo does not use semantic commits, so keep
    // Renovate's commit subjects plain and use bracketed prefixes instead.
    ":semanticCommitsDisabled",
    // Open a "Dependency Dashboard" issue listing everything Renovate sees,
    // including updates that are rate-limited or awaiting approval.
    ":dependencyDashboard",
  ],

  timezone: "America/New_York",
  // Batch everything into a weekly window so dependency PRs don't trickle in
  // throughout the week.
  schedule: ["before 9am on monday"],

  labels: ["dependencies"],
  prConcurrentLimit: 5,
  // The weekly schedule is the rate limit; don't further throttle within it.
  prHourlyLimit: 0,

  // Keep the Renovate branches from colliding with the repo's own naming.
  branchPrefix: "renovate/",

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 9am on the first day of the month"],
    // One refresh PR across every lock file, rather than one per ecosystem.
    groupName: "lock file maintenance",
    commitMessagePrefix: "[deps]",
  },

  // Vulnerability alerts bypass `packageRules` grouping, so without this every
  // advisory opens its own PR. Keep them on a single fast-tracked PR that still
  // ignores the weekly schedule and the minimumReleaseAge delays below.
  vulnerabilityAlerts: {
    groupName: "security updates",
    commitMessagePrefix: "[security]",
    labels: ["dependencies", "security"],
  },

  // ---------------------------------------------------------------------------
  // Manager file patterns
  //
  // The `kubernetes` and `flux` managers have no useful default file patterns,
  // so point them at the manifests in k8s/.
  // ---------------------------------------------------------------------------
  kubernetes: {
    managerFilePatterns: ["k8s/**/*.yaml", "k8s/**/*.yml"],
  },
  flux: {
    managerFilePatterns: ["k8s/**/*.yaml", "k8s/**/*.yml"],
  },

  packageRules: [
    // -------------------------------------------------------------------------
    // Exclusions
    // -------------------------------------------------------------------------
    {
      // Images under ghcr.io/spack/ are built *from this repo*. Their versions
      // are hand-bumped in .github/images.yml, and
      // .github/scripts/check_docker_image_versions.sh enforces that a bump
      // touches images.yml and leaves no stale tags behind. Renovate bumping a
      // tag in a k8s manifest would both break that invariant and try to pull a
      // tag that has not been built yet.
      matchPackageNames: ["ghcr.io/spack/**"],
      enabled: false,
    },
    {
      // k8s/*/flux-system/gotk-components.yaml is generated by `flux bootstrap`
      // and must be regenerated as a unit rather than patched image-by-image.
      // The `flux` manager updates the Flux version there correctly; the
      // `kubernetes` manager would rewrite individual controller images.
      matchManagers: ["kubernetes"],
      matchFileNames: ["**/gotk-components.yaml"],
      enabled: false,
    },
    {
      // Ports the ignore block from the previous Dependabot config.
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },

    // -------------------------------------------------------------------------
    // Grouping: one PR per ecosystem per week.
    // -------------------------------------------------------------------------
    {
      // `github-runners` covers the `runs-on:` labels (e.g. macos-12), which
      // age out just like the actions themselves.
      matchManagers: ["github-actions", "github-runners"],
      groupName: "github actions",
      commitMessagePrefix: "[gh-actions]",
    },
    {
      // `terraform-version` covers the .terraform-version files pinning the CLI.
      matchManagers: ["terraform", "terraform-version"],
      groupName: "terraform providers and modules",
      commitMessagePrefix: "[terraform]",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      groupName: "docker base images",
      commitMessagePrefix: "[docker]",
    },
    {
      matchManagers: ["kubernetes", "kustomize"],
      groupName: "kubernetes manifest images",
      commitMessagePrefix: "[k8s]",
    },
    {
      matchManagers: ["flux", "helm-values", "helmv3"],
      groupName: "helm charts",
      commitMessagePrefix: "[helm]",
    },
    {
      matchManagers: [
        "pip_requirements",
        "pip-compile",
        "pep621",
        "poetry",
        "pixi",
      ],
      groupName: "python dependencies",
      commitMessagePrefix: "[python]",
    },

    // -------------------------------------------------------------------------
    // Update-type specific handling
    // -------------------------------------------------------------------------
    {
      // Major bumps of infrastructure components are rarely drop-in, so keep
      // them out of the minor/patch PRs. They still land as one PR per
      // ecosystem (see the rules below) rather than one PR per dependency.
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      minimumReleaseAge: "7 days",
      groupName: "other major updates",
      commitMessagePrefix: "[deps]",
    },
    // These re-split the catch-all above per ecosystem. They must come *after*
    // it, since the last matching rule wins.
    {
      matchManagers: ["github-actions", "github-runners"],
      matchUpdateTypes: ["major"],
      groupName: "github actions major updates",
      commitMessagePrefix: "[gh-actions]",
    },
    {
      matchManagers: ["terraform", "terraform-version"],
      matchUpdateTypes: ["major"],
      groupName: "terraform major updates",
      commitMessagePrefix: "[terraform]",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      matchUpdateTypes: ["major"],
      groupName: "docker base image major updates",
      commitMessagePrefix: "[docker]",
    },
    {
      matchManagers: ["kubernetes", "kustomize"],
      matchUpdateTypes: ["major"],
      groupName: "kubernetes manifest image major updates",
      commitMessagePrefix: "[k8s]",
    },
    {
      matchManagers: ["flux", "helm-values", "helmv3"],
      matchUpdateTypes: ["major"],
      groupName: "helm chart major updates",
      commitMessagePrefix: "[helm]",
    },
    {
      matchManagers: [
        "pip_requirements",
        "pip-compile",
        "pep621",
        "poetry",
        "pixi",
      ],
      matchUpdateTypes: ["major"],
      groupName: "python major updates",
      commitMessagePrefix: "[python]",
    },
    {
      // Let a release sit briefly before adopting it, so yanked or immediately
      // patched versions don't land here.
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
    },
  ],
}
